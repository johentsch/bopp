{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/times.json",
  "title": "Timestamps",
  "description": "Instants: one coordinate per observation.",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "timestamps"
    },
    "time": {
      "$ref": "../coordinate.json",
      "description": "N positions on the timeline."
    }
  },
  "required": [
    "extent_type",
    "time"
  ]
}

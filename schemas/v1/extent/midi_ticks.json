{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extents/midi_ticks.json",
  "title": "MIDI Ticks",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "midi_ticks"
    },
    "tick": {
      "$ref": "../core.json#/$defs/Array",
      "description": "An array of MIDI tick values. MIDI ticks are integers by nature; floats are accepted for quantities derived by scaling or interpolation.",
      "items": {
        "type": ["integer", "number"]
      }
    }
  },
  "required": ["extent_type", "tick"]
}

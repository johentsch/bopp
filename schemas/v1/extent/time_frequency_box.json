{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extent/time_frequency_box.json",
  "title": "Time-Frequency Box Extent",
  "type": "object",
  "properties": {
    "extent_type": {
      "const": "TimeFrequencyBox"
    },
    "start": {
      "$ref": "../coordinate.json",
      "description": "N box start positions."
    },
    "duration": {
      "$ref": "../coordinate.json",
      "description": "N box durations, same unit as start."
    },
    "freq_min": {
      "$ref": "../core.json#/$defs/Float32Buffer",
      "description": "Array of minimum frequencies in Hz.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    },
    "freq_max": {
      "$ref": "../core.json#/$defs/Float32Buffer",
      "description": "Array of maximum frequencies in Hz.",
      "items": {
        "type": "number",
        "minimum": 0.0
      }
    }
  },
  "required": [
    "extent_type",
    "start",
    "duration",
    "freq_min",
    "freq_max"
  ]
}
